[Unit]
Description=CMMS Tecnosur Mantenimiento (Gunicorn)
Requires=tacora-mantenimiento.socket
After=network.target

[Service]
User=imrodriguez
Group=www-data
WorkingDirectory=/home/imrodriguez/tacora-mantenimiento
ExecStart=/home/imrodriguez/tacora-mantenimiento/.venv/bin/gunicorn \
          --workers 3 \
          --timeout 120 \
          --bind unix:/run/tacora-mantenimiento.sock \
          config.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
